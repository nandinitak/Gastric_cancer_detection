# ─────────────────────────────────────────────────────────────
# Gastric Cancer Hub — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────────

# Google OAuth credentials
# Get from: https://console.cloud.google.com/
# Project → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# NextAuth secret — any random string (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-random-secret-string-here

# Your deployed URL (use http://localhost:3000 for local dev)
# Change to your Vercel URL after deploying, e.g.:
# NEXTAUTH_URL=https://gastric-cancer-hub.vercel.app
NEXTAUTH_URL=http://localhost:3000
